{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "upzites-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@upzites/web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "crm",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@upzites/crm", "dev"],
      "port": 3001,
      "autoPort": true
    }
  ]
}
