# Copy this file to .env.local and fill in the value.
# In production (e.g. your host/Vercel), set the same variable in the project's
# Environment Variables.
#
# PageSpeed Insights API key for the free site-audit tool.
# It is used from the browser (client-side), so restrict it by HTTP referrer
# (e.g. https://www.upzites.com/*) in Google Cloud Console — NOT by IP or API
# only, since the request carries the site's referrer.
NEXT_PUBLIC_PAGESPEED_KEY=

# Meta Pixel ID. Set this in Vercel Production/Preview env vars.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional: comma-separated list for multiple pixels.
NEXT_PUBLIC_META_PIXEL_IDS=

# Set to true only if a marketing-cookie consent gate must block Meta tracking
# until the user accepts. Leaving it false keeps Meta's setup tool detection simple.
NEXT_PUBLIC_META_PIXEL_REQUIRE_CONSENT=false

# CRM capture integration. Use the public CRM URL in production.
NEXT_PUBLIC_CRM_BASE_URL=http://localhost:3001
CRM_CAPTURE_FORM_PUBLIC_ID=
CRM_PUBLIC_KEY=

# Resend (contact form emails). Without it the form still works but no email is sent.
RESEND_API_KEY=

# --- Contact form anti-spam (/api/contact) ---------------------------------
# Cloudflare Turnstile. Set BOTH or NEITHER: the server only requires a token
# when TURNSTILE_SECRET_KEY exists, and the widget only renders when the site
# key exists (NEXT_PUBLIC_* is baked in at build time -> redeploy after setting).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Persistent rate limit (Upstash Redis REST). Without it the limit is only
# per-serverless-instance (best effort). The Vercel Marketplace Upstash
# integration injects KV_REST_API_URL / KV_REST_API_TOKEN, also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
