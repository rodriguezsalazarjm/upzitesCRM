# Runtime connection used by Vercel. Use the Supabase pooler URL.
# Example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DATABASE_URL=""

# Direct connection used by Prisma CLI for migrations and seed.
# Example:
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL=""

CRM_SESSION_SECRET="change-me-in-production"
NEXT_PUBLIC_CRM_BASE_URL="http://localhost:3001"

# Mercado Pago (Checkout Pro). Usa credenciales TEST-... primero (Developers >
# Tus integraciones > Credenciales de prueba); cambia a APP_USR-... en produccion.
MERCADO_PAGO_ACCESS_TOKEN=""
# Clave secreta de la integracion (misma pagina), usada para validar la firma
# x-signature de las notificaciones webhook.
MERCADO_PAGO_WEBHOOK_SECRET=""

# --- WhatsApp Cloud API (Fase 2) ---------------------------------------------
# App Secret de la app de Meta. Firma las entregas del webhook (x-hub-signature-256).
META_APP_SECRET=""
# Token que eliges tu; Meta lo devuelve en el handshake GET del webhook.
WHATSAPP_VERIFY_TOKEN=""
# Opcional: fija la version de Graph API. Por defecto v21.0.
WHATSAPP_GRAPH_API_VERSION=""
# Solo para pilotos con onboarding manual: token de sistema usado si el canal
# no tiene uno propio guardado.
WHATSAPP_SYSTEM_ACCESS_TOKEN=""

# --- Secretos de plataforma ---------------------------------------------------
# Clave AES-256 para cifrar tokens de integracion. 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=""
# Protege /api/internal/*. Cualquier cadena larga y aleatoria.
INTERNAL_WORKER_SECRET=""

# --- Shopify (Fase 6) ---------------------------------------------------------
# Credenciales de la app de Shopify (Partners > Apps > API credentials).
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# URL publica de la app; por defecto usa NEXT_PUBLIC_CRM_BASE_URL.
SHOPIFY_APP_URL=""
# Scopes minimos. Por defecto: read_products,read_inventory,write_draft_orders,read_orders,read_fulfillments
SHOPIFY_SCOPES=""
# Version de la Admin API. Por defecto 2025-01.
SHOPIFY_API_VERSION=""
