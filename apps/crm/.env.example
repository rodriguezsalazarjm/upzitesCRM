# Runtime connection used by Vercel. Use the Supabase pooler URL.
# Example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DATABASE_URL=""

# Direct connection used by Prisma CLI for migrations and seed.
# Example:
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL=""

CRM_SESSION_SECRET="change-me-in-production"
NEXT_PUBLIC_CRM_BASE_URL="http://localhost:3001"

# Mercado Pago de UPZITES (Checkout Pro), solo para cobrar la SUSCRIPCION del
# CRM a cada workspace. La venta de productos propios de un workspace (Fase A:
# infoproductos, servicios) NO usa esto — cada workspace conecta su propia
# cuenta desde Integraciones > Mercado Pago, cifrada por separado.
# Usa credenciales TEST-... primero (Developers > Tus integraciones >
# Credenciales de prueba); cambia a APP_USR-... en produccion.
MERCADO_PAGO_ACCESS_TOKEN=""
# Clave secreta de la integracion (misma pagina), usada para validar la firma
# x-signature de las notificaciones webhook de la suscripcion del CRM.
MERCADO_PAGO_WEBHOOK_SECRET=""

# Aplicacion OAuth de Mercado Pago de UPZITES FLOW (marketplace/Connect):
# con esto cada workspace autoriza a Upzites Flow a cobrar en su nombre con
# UN CLIC, sin copiar ningun token manualmente. Se crea en
# Mercado Pago Developers > Tus integraciones > (tu app) > OAuth. El Bearer
# de las llamadas a /oauth/token es MERCADO_PAGO_ACCESS_TOKEN (arriba): la
# API de Mercado Pago exige autenticar asi el intercambio/refresh ademas del
# client_id/client_secret. Sin estas dos variables, la tarjeta de
# Integraciones > Mercado Pago ofrece solo la conexion manual.
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""

# --- Email transaccional (Resend) --------------------------------------------
# Remitente central de Upzites Flow (todavia no es por workspace; ver
# src/lib/email/send.ts). SCRIPTED no llama a Resend: guarda los envios en
# memoria y es lo que usan tests y validacion local.
EMAIL_PROVIDER="SCRIPTED"
# API key de Resend (resend.com/api-keys). Solo hace falta con EMAIL_PROVIDER=RESEND.
RESEND_API_KEY=""
# Secreto del webhook de Resend (Webhooks > tu endpoint > Signing Secret),
# usado para verificar los eventos de entrega/apertura/rebote (formato Svix).
EMAIL_WEBHOOK_SECRET=""

# --- WhatsApp Cloud API (Fase 2) ---------------------------------------------
# App Secret de la app de Meta. Firma las entregas del webhook (x-hub-signature-256).
META_APP_SECRET=""
# Token que eliges tu; Meta lo devuelve en el handshake GET del webhook.
WHATSAPP_VERIFY_TOKEN=""
# Opcional: fija la version de Graph API. Por defecto v26.0.
WHATSAPP_GRAPH_API_VERSION=""
# Solo para pilotos con onboarding manual: token de sistema usado si el canal
# no tiene uno propio guardado.
WHATSAPP_SYSTEM_ACCESS_TOKEN=""

# --- Instagram / Messenger (Fase C) -------------------------------------------
# Misma app de Meta que WhatsApp: META_APP_SECRET (arriba) firma tambien estos
# dos webhooks. Cada suscripcion dentro de la app usa su propio verify token.
INSTAGRAM_VERIFY_TOKEN=""
MESSENGER_VERIFY_TOKEN=""

# --- TikTok Business Messaging (Fase C) ---------------------------------------
# Exige Advanced Access o cuenta de negocio verificada (no disponible para
# cuentas registradas en UE/Reino Unido/Suiza; India tampoco entra en el DM
# API) — ver informe: "ACCION MANUAL TIKTOK REQUERIDA". El client secret firma
# el webhook (header TikTok-Signature); sin esto, el proveedor queda inactivo
# y las automatizaciones de TikTok no se pueden publicar.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- Pruebas destructivas aisladas -------------------------------------------
# Nunca apuntes estas variables al proyecto de produccion. Los smoke tests
# comparan el destino y exigen ademas el marcador documentado de la base.
TEST_DATABASE_URL=""
# Opcional: conexion directa al mismo destino aislado para aplicar migraciones.
TEST_DIRECT_URL=""

# --- Secretos de plataforma ---------------------------------------------------
# Clave AES-256 para cifrar tokens de integracion. 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=""
# Protege /api/internal/*. Cualquier cadena larga y aleatoria.
INTERNAL_WORKER_SECRET=""

# --- Notificaciones Web Push -------------------------------------------------
# Genera el par una sola vez con: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Correo o URL de contacto que recibe el proveedor push.
VAPID_SUBJECT="mailto:soporte@upzites.com"

# --- Archivos recibidos (medios de WhatsApp) ---------------------------------
# Donde se guardan las fotos, audios y documentos que mandan los clientes.
# WhatsApp entrega un identificador que caduca, no el archivo: si no hay donde
# guardarlo, el adjunto queda visible en la bandeja como "falta configurar el
# almacenamiento" y se reintenta solo cuando estas variables existan.
#
# En produccion tiene que ser un bucket PRIVADO. El disco local no sirve: el
# sistema de archivos de Vercel es efimero.
#   supabase   -> bucket privado del mismo proyecto Supabase (recomendado)
#   filesystem -> disco local, solo desarrollo y pruebas
# Si se deja vacio se deduce: hay claves de Supabase -> supabase; si no, disco.
MEDIA_STORAGE_DRIVER=""
# Project URL de Supabase (Settings > API). No es la cadena de conexion.
SUPABASE_URL=""
# SECRETO. service_role key: salta las politicas de acceso, solo servidor.
SUPABASE_SERVICE_ROLE_KEY=""
# Nombre del bucket privado. Por defecto: crm-media
MEDIA_STORAGE_BUCKET=""
# Dias que se conserva un archivo recibido antes de borrarlo. Por defecto: 180
MEDIA_RETENTION_DAYS=""

# --- Shopify (Fase 6) ---------------------------------------------------------
# Credenciales de la app de Shopify (Partners > Apps > API credentials).
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# URL publica de la app; por defecto usa NEXT_PUBLIC_CRM_BASE_URL.
SHOPIFY_APP_URL=""
# Scopes minimos. Por defecto: read_products,read_inventory,write_draft_orders,read_orders,read_fulfillments
SHOPIFY_SCOPES=""
# Version de la Admin API. Por defecto 2025-01.
SHOPIFY_API_VERSION=""
