generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  publicKey String   @unique @default(cuid()) @map("public_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  companies       Company[]
  contacts        Contact[]
  pipelineStages  PipelineStage[]
  opportunities   Opportunity[]
  activities      Activity[]
  leadSources     LeadSource[]
  forms           Form[]
  formSubmissions FormSubmission[]
  webEvents       WebEvent[]
  integrations    Integration[]
  automationRules AutomationRule[]
  aiInsights      AiInsight[]
  auditLogs       AuditLog[]
  subscriptions   WorkspaceSubscription[]

  contactConsents    ContactChannelConsent[]
  suppressionEntries SuppressionEntry[]
  leadScoreRules     LeadScoreRule[]
  leadScoreSnapshots LeadScoreSnapshot[]
  scheduledActions   ScheduledAction[]
  usageRecords       UsageRecord[]

  whatsappChannels WhatsAppChannel[]
  conversations    Conversation[]
  messages         Message[]
  outboxEvents     OutboxEvent[]

  jobs                 Job[]
  automationExecutions AutomationExecution[]

  agentDefinitions AgentDefinition[]
  agentRuns        AgentRun[]

  commerceConnections   CommerceConnection[]
  mercadoPagoConnection MercadoPagoConnection?
  products              Product[]
  orders              CustomerOrder[]
  payments            Payment[]
  digitalAssets       DigitalAsset[]
  digitalDeliveries   DigitalDelivery[]

  pricingRuleSets  PricingRuleSet[]
  quotes           Quote[]
  approvalRequests ApprovalRequest[]

  featureFlags   FeatureFlag[]

  profile        WorkspaceProfile?
  activation     WorkspaceActivation?
  usageCounters  UsageCounter[]
  alerts         WorkspaceAlert[]
  pushSubscriptions PushSubscription[]

  messagingPolicy    MessagingPolicy?
  segments           Segment[]
  journeys           Journey[]
  journeyEnrollments JourneyEnrollment[]
  emailDomains       EmailDomain[]
  emailTemplates     EmailTemplate[]
  campaigns          Campaign[]
  emailMessages      EmailMessage[]
  emailEvents        EmailEvent[]
  contactSendLogs    ContactSendLog[]

  mediaAssets        MediaAsset[]

  channelAccounts          ChannelAccount[]
  contactChannelIdentities ContactChannelIdentity[]
  channelEvents            ChannelEvent[]
  automationFlows          AutomationFlow[]
  automationFlowRuns       AutomationFlowRun[]

  @@map("workspaces")
  knowledgeSources KnowledgeSource[]

}

model User {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  name         String
  email        String
  passwordHash String   @map("password_hash")
  role         UserRole @default(SALES)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownedOpportunities  Opportunity[]        @relation("OpportunityOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  createdActivities   Activity[]           @relation("ActivityCreator")
  passwordResetTokens PasswordResetToken[]
  assignedConversations Conversation[]     @relation("ConversationAssignee")
  sentMessages          Message[]          @relation("MessageSender")
  pushSubscriptions     PushSubscription[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Company {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  website     String?
  industry    String?
  size        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  opportunities Opportunity[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("companies")
}

model Contact {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  companyId      String?       @map("company_id")
  ownerId        String?       @map("owner_id")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String?
  phone          String?
  status         ContactStatus @default(LEAD)
  source         String?
  utmSource      String?       @map("utm_source")
  utmMedium      String?       @map("utm_medium")
  utmCampaign    String?       @map("utm_campaign")
  value          Int           @default(0)
  tags           String[]      @default([])
  /// Campos dinamicos por workspace (Flow Builder: nodo CONDITION/ACTION).
  /// No hay UI de definicion de esquema todavia: es un mapa libre {key: value}.
  customFields   Json?         @map("custom_fields")
  lastActivityAt DateTime?     @map("last_activity_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Dimensiones independientes del estado comercial. `status` (ContactStatus)
  // se mantiene por compatibilidad con la UI y las rutas actuales; la fuente de
  // verdad del ciclo de vida es `lifecycleStatus`. Ver src/lib/domain/lifecycle.ts.
  lifecycleStatus LifecycleStatus @default(LEAD) @map("lifecycle_status")
  temperature     LeadTemperature @default(COLD)
  buyingIntent    BuyingIntent    @default(UNKNOWN) @map("buying_intent")
  leadScore       Int             @default(0) @map("lead_score")
  scoreUpdatedAt  DateTime?       @map("score_updated_at")

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner            User?                  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  opportunities    Opportunity[]
  activities       Activity[]
  formSubmissions  FormSubmission[]
  aiInsights       AiInsight[]
  consents         ContactChannelConsent[]
  scoreSnapshots   LeadScoreSnapshot[]
  scheduledActions ScheduledAction[]
  conversations    Conversation[]
  orders           CustomerOrder[]
  deliveries       DigitalDelivery[]
  quotes           Quote[]

  journeyEnrollments JourneyEnrollment[]
  campaignRecipients CampaignRecipient[]
  emailMessages      EmailMessage[]
  sendLogs           ContactSendLog[]
  channelIdentities  ContactChannelIdentity[]
  automationFlowRuns AutomationFlowRun[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, lifecycleStatus])
  @@index([workspaceId, temperature])
  @@map("contacts")
}

model PipelineStage {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  key         OpportunityStage
  name        String
  position    Int
  probability Int
  isWon       Boolean          @default(false) @map("is_won")
  isLost      Boolean          @default(false) @map("is_lost")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
  @@map("pipeline_stages")
}

model Opportunity {
  id                String            @id @default(cuid())
  workspaceId       String            @map("workspace_id")
  contactId         String?           @map("contact_id")
  companyId         String?           @map("company_id")
  stageId           String            @map("stage_id")
  ownerId           String?           @map("owner_id")
  title             String
  value             Int               @default(0)
  probability       Int
  expectedCloseDate DateTime?         @map("expected_close_date")
  status            OpportunityStatus @default(OPEN)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner      User?         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]
  aiInsights AiInsight[]

  @@index([workspaceId, status])
  @@index([workspaceId, stageId])
  @@map("opportunities")
}

model Activity {
  id            String       @id @default(cuid())
  workspaceId   String       @map("workspace_id")
  contactId     String?      @map("contact_id")
  opportunityId String?      @map("opportunity_id")
  createdById   String?      @map("created_by")
  type          ActivityType
  title         String
  description   String?
  dueAt         DateTime?    @map("due_at")
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, type])
  @@map("activities")
}

model LeadSource {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@map("lead_sources")
}

model Form {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  publicId    String   @unique @default(cuid()) @map("public_id")
  name        String
  title       String
  description String?
  submitLabel String   @default("Enviar") @map("submit_label")
  source      String   @default("Formulario web")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([workspaceId])
  @@map("forms")
}

model FormSubmission {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  formId      String   @map("form_id")
  contactId   String?  @map("contact_id")
  payload     Json
  pageUrl     String?  @map("page_url")
  referrer    String?
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([formId])
  @@map("form_submissions")
}

model WebEvent {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  type        WebEventType
  pageUrl     String       @map("page_url")
  referrer    String?
  element     String?
  formId      String?      @map("form_id")
  contactId   String?      @map("contact_id")
  visitorId   String?      @map("visitor_id")
  sessionId   String?      @map("session_id")
  utmSource   String?      @map("utm_source")
  utmMedium   String?      @map("utm_medium")
  utmCampaign String?      @map("utm_campaign")
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, createdAt])
  @@index([workspaceId, pageUrl])
  @@map("web_events")
}

model Integration {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  provider    IntegrationProvider
  name        String
  status      IntegrationStatus   @default(DISCONNECTED)
  config      Json?
  lastSyncAt  DateTime?           @map("last_sync_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
  @@map("integrations")
}

model AutomationRule {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  name        String
  description String?
  trigger     AutomationTrigger
  isActive    Boolean           @default(true) @map("is_active")

  /// Grupo de condiciones validado con Zod: { match: "ALL" | "ANY", rules: [...] }.
  /// Null significa "sin condiciones": la regla corre en cada disparo.
  conditions Json?

  /// Lista de acciones a ejecutar en orden, validada con Zod.
  /// Reemplaza al par action/actionConfig, que queda solo por compatibilidad.
  actions Json?

  /// Deprecados: los conserva una regla creada antes de la Fase 3.
  action       AutomationAction?
  actionConfig Json?             @map("action_config")

  /// Ventana de deduplicacion por contacto, en minutos. Evita que un mismo
  /// contacto dispare la misma regla dos veces seguidas.
  dedupeMinutes Int       @default(0) @map("dedupe_minutes")
  lastRunAt     DateTime? @map("last_run_at")
  runCount      Int       @default(0) @map("run_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, trigger, isActive])
  @@map("automation_rules")
}

model AiInsight {
  id            String        @id @default(cuid())
  workspaceId   String        @map("workspace_id")
  contactId     String?       @map("contact_id")
  opportunityId String?       @map("opportunity_id")
  type          AiInsightType
  title         String
  description   String
  score         Int?
  status        InsightStatus @default(OPEN)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@map("ai_insights")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  priceClp    Int      @map("price_clp")
  maxUsers    Int      @map("max_users")
  maxContacts Int      @map("max_contacts")
  features    String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")

  /// Fase 9: que puede hacer el plan. Claves de `PlanCapability`, validadas con
  /// Zod al leerlas. `features` sigue siendo texto para mostrar en la pagina de
  /// precios; esto es lo que el codigo consulta.
  capabilities String[] @default([]) @map("capabilities")

  /// Cupos mensuales por metrica. **Ninguno es ilimitado** (regla de la spec):
  /// un plan sin la metrica declarada no la permite en absoluto.
  allowances Json? @map("allowances")

  /// Precio del excedente por unidad, cuando el plan lo admite. Sin entrada
  /// para una metrica, pasarse la bloquea en vez de cobrarla.
  overages Json?

  isActive Boolean @default(true) @map("is_active")
  position Int     @default(0)

  subscriptions WorkspaceSubscription[]

  @@map("subscription_plans")
}

model WorkspaceSubscription {
  id             String             @id @default(cuid())
  workspaceId    String             @map("workspace_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(TRIAL)
  trialEndsAt    DateTime?          @map("trial_ends_at")
  renewsAt       DateTime?          @map("renews_at")
  mpPreferenceId String?            @map("mp_preference_id")
  mpPaymentId    String?            @unique @map("mp_payment_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@map("workspace_subscriptions")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  actorId     String?  @map("actor_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

/// Consentimiento por canal. Es independiente para WhatsApp, email y publicidad:
/// aceptar recibir la confirmacion de una compra no habilita marketing.
model ContactChannelConsent {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  contactId   String        @map("contact_id")
  channel     ConsentChannel
  status      ConsentStatus @default(UNKNOWN)
  source      String?
  evidence    Json?
  grantedAt   DateTime?     @map("granted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channel])
  @@index([workspaceId, channel, status])
  @@map("contact_channel_consents")
}

/// Lista de supresion a nivel de workspace. Sobrevive al borrado del contacto y
/// a una reimportacion por CSV: la identidad es el email o telefono normalizado.
model SuppressionEntry {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  channel     ConsentChannel
  identifier  String
  reason      SuppressionReason @default(USER_REQUEST)
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channel, identifier])
  @@index([workspaceId, channel])
  @@map("suppression_entries")
}

/// Reglas de scoring versionadas por workspace. El score es calculado y
/// explicable: nunca reemplaza la etapa del pipeline.
model LeadScoreRule {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  key         String
  label       String
  points      Int
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, isActive])
  @@map("lead_score_rules")
}

/// Foto del score en un momento dado, con las razones que lo produjeron.
model LeadScoreSnapshot {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  contactId   String          @map("contact_id")
  score       Int
  temperature LeadTemperature
  reasons     Json
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactId, createdAt])
  @@map("lead_score_snapshots")
}

/// Accion diferida (seguimiento, recordatorio, recuperacion). `cancelKey` agrupa
/// las acciones de un mismo motivo para poder cancelarlas de una sola vez cuando
/// el contacto responde, paga o revoca el consentimiento.
model ScheduledAction {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  contactId   String?               @map("contact_id")
  type        ScheduledActionType
  status      ScheduledActionStatus @default(PENDING)
  payload     Json?
  cancelKey   String?               @map("cancel_key")
  runAt       DateTime              @map("run_at")
  attempts    Int                   @default(0)
  lastError   String?               @map("last_error")
  processedAt DateTime?             @map("processed_at")
  canceledAt  DateTime?             @map("canceled_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([workspaceId, cancelKey])
  @@index([workspaceId, contactId])
  @@map("scheduled_actions")
}

/// Consumo medido por workspace (mensajes, tokens de IA, emails). Base para los
/// limites de plan y los excedentes.
model UsageRecord {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  provider      String
  metric        String
  quantity      Int
  costEstimate  Int      @default(0) @map("cost_estimate")
  currency      String   @default("CLP")
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric, occurredAt])
  @@index([workspaceId, provider])
  @@map("usage_records")
}

// --- Fase 2: mensajeria WhatsApp --------------------------------------------

/// Numero de WhatsApp de un workspace. El token nunca se guarda en claro ni se
/// expone al cliente: se cifra con INTEGRATION_ENCRYPTION_KEY (ver lib/crypto).
/// `phoneNumberId` es unico global: es la llave con la que el webhook resuelve
/// a que workspace pertenece un evento entrante.
model WhatsAppChannel {
  id                   String                @id @default(cuid())
  workspaceId          String                @map("workspace_id")
  integrationId        String?               @map("integration_id")
  wabaId               String                @map("waba_id")
  phoneNumberId        String                @unique @map("phone_number_id")
  displayPhoneNumber   String                @map("display_phone_number")
  businessName         String?               @map("business_name")
  accessTokenEncrypted String?               @map("access_token_encrypted")
  tokenExpiresAt       DateTime?             @map("token_expires_at")
  status               WhatsAppChannelStatus @default(PENDING)
  qualityRating        String?               @map("quality_rating")
  messagingLimit       String?               @map("messaging_limit")
  webhookSubscribedAt  DateTime?             @map("webhook_subscribed_at")
  lastHealthCheckAt    DateTime?             @map("last_health_check_at")
  metadata             Json?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId, status])
  @@map("whatsapp_channels")
}

// --- Fase C: gateway multicanal (Instagram/Messenger/TikTok + WhatsApp) ------
//
// WhatsApp se deja tal cual (WhatsAppChannel + Conversation.channelId siguen
// funcionando sin cambios): es la unica migracion segura para no reescribir un
// pipeline ya probado en produccion. Los canales nuevos entran por un camino
// PARALELO — ChannelAccount + Conversation.channelAccountId — que Conversation
// ya sabe distinguir por `channelType`. Unificar WhatsAppChannel dentro de
// ChannelAccount queda como limpieza futura, no como parte de esta fase.

enum Channel {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  TIKTOK
}

enum ChannelConnectionMethod {
  OAUTH
  MANUAL
}

/// Mismo vocabulario de estado que MercadoPagoConnection (Fase A2), no por
/// capricho: es el mismo problema (token propio de un tercero, cifrado, que
/// puede vencer o ser revocado) para un canal en vez de para un medio de pago.
enum ChannelAccountStatus {
  DISCONNECTED
  CONNECTED
  NEEDS_ATTENTION
  REAUTH_REQUIRED
}

/// La cuenta de Instagram/Messenger/TikTok de UN workspace. `capabilities` NO
/// es lo que la API del canal ofrece en general (eso es estatico, ver
/// src/lib/channels/capabilities.ts) — es lo que ESTA conexion en particular
/// tiene confirmado (beta features como follow-to-DM pueden estar disponibles
/// para una cuenta y no para otra). La UI nunca debe ofrecer una automatizacion
/// cuya capability no este en esta lista.
model ChannelAccount {
  id                    String                   @id @default(cuid())
  workspaceId           String                   @map("workspace_id")
  channel               Channel
  connectionMethod      ChannelConnectionMethod  @default(MANUAL) @map("connection_method")
  externalAccountId     String                   @map("external_account_id")
  displayName           String?                  @map("display_name")
  accessTokenEncrypted  String?                  @map("access_token_encrypted")
  refreshTokenEncrypted String?                  @map("refresh_token_encrypted")
  accessTokenExpiresAt  DateTime?                @map("access_token_expires_at")
  scopes                String?
  capabilities          String[]                 @default([])
  status                ChannelAccountStatus     @default(DISCONNECTED)
  connectedAt           DateTime?                @map("connected_at")
  lastVerifiedAt        DateTime?                @map("last_verified_at")
  lastErrorCode         String?                  @map("last_error_code")
  lastError             String?                  @map("last_error")
  metadata              Json?
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  identities    ContactChannelIdentity[]
  events        ChannelEvent[]

  // Una cuenta externa (una pagina de FB, una cuenta IG) solo puede estar
  // conectada a UN workspace a la vez: igual que el dominio de Shopify o el
  // vendedor de Mercado Pago, no se reasigna en silencio.
  @@unique([channel, externalAccountId])
  @@index([workspaceId, channel])
  @@map("channel_accounts")
}

/// Vincula un Contact con su identidad EN UN canal concreto (IGSID, PSID,
/// open id de TikTok...). Nunca se fusiona automaticamente solo por nombre
/// visible: la spec es explicita en que un mismo Contact por dos canales
/// necesita evidencia (email/telefono confirmado) o vinculo manual, no
/// coincidencia de display name.
model ContactChannelIdentity {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  contactId        String   @map("contact_id")
  channel          Channel
  channelAccountId String   @map("channel_account_id")
  externalUserId   String   @map("external_user_id")
  displayName      String?  @map("display_name")
  createdAt        DateTime @default(now()) @map("created_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  // La misma persona real vista desde dos cuentas conectadas distintas (dos
  // paginas de FB, por ejemplo) es, a proposito, DOS identidades: cada una
  // vive dentro de su propia cuenta externa.
  @@unique([channelAccountId, externalUserId])
  @@index([workspaceId, contactId])
  @@map("contact_channel_identities")
}

enum ChannelEventType {
  DM_RECEIVED
  COMMENT
  STORY_REPLY
  STORY_MENTION
  LIVE_COMMENT
  FOLLOW
  SHARE
  AD_CONVERSATION_STARTED
  REF_LINK
  QR_SCAN
}

enum ChannelEventStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

/// El evento NORMALIZADO que sale del gateway hacia el motor de
/// automatizaciones. Cada proveedor (Meta para IG/Messenger, TikTok) tiene su
/// propio formato de webhook; nada al otro lado de este modelo deberia conocer
/// esos formatos. `idempotencyKey` es la defensa contra reintentos/duplicados
/// del proveedor, igual que WebhookEvent para WhatsApp/Shopify/email.
model ChannelEvent {
  id               String             @id @default(cuid())
  workspaceId      String             @map("workspace_id")
  channel          Channel
  channelAccountId String             @map("channel_account_id")
  type             ChannelEventType
  externalUserId   String             @map("external_user_id")
  contactId        String?            @map("contact_id")
  conversationId   String?            @map("conversation_id")
  content          Json?
  rawMetadata      Json?              @map("raw_metadata")
  idempotencyKey   String             @unique @map("idempotency_key")
  status           ChannelEventStatus @default(PENDING)
  processedAt      DateTime?          @map("processed_at")
  error            String?
  createdAt        DateTime           @default(now()) @map("created_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, channel, createdAt])
  @@index([workspaceId, status])
  @@map("channel_events")
}

/// Hilo con un contacto en un canal. Estrategia de reapertura elegida: UNA
/// conversacion por (canal, contacto). Un mensaje entrante sobre una cerrada la
/// reabre en vez de crear otra, para no fragmentar el historial.
///
/// `channelId` (WhatsApp) y `channelAccountId` (Instagram/Messenger/TikTok) son
/// dos caminos que conviven: cada conversacion usa exactamente uno, segun
/// `channelType`. Ambas columnas son nullable porque cada fila solo llena la
/// que le corresponde — nunca las dos, nunca ninguna.
model Conversation {
  id                          String             @id @default(cuid())
  workspaceId                 String             @map("workspace_id")
  channelType                 Channel            @default(WHATSAPP) @map("channel_type")
  channelId                   String?            @map("channel_id")
  channelAccountId            String?            @map("channel_account_id")
  contactId                   String             @map("contact_id")
  assignedUserId              String?            @map("assigned_user_id")
  mode                        ConversationMode   @default(WAITING)
  status                      ConversationStatus @default(OPEN)
  currentAgentId              String?            @map("current_agent_id")
  lastInboundAt               DateTime?          @map("last_inbound_at")
  lastOutboundAt              DateTime?          @map("last_outbound_at")
  lastMessageAt               DateTime           @default(now()) @map("last_message_at")
  customerServiceWindowEndsAt DateTime?          @map("customer_service_window_ends_at")
  unreadCount                 Int                @default(0) @map("unread_count")
  summary                     String?
  lockVersion                 Int                @default(0) @map("lock_version")
  closedAt                    DateTime?          @map("closed_at")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel        WhatsAppChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount?  @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee   User?                    @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages   Message[]
  agentRuns  AgentRun[]
  agentState ConversationAgentState?
  mediaAssets MediaAsset[]
  flowRuns   AutomationFlowRun[]

  @@unique([channelId, contactId])
  @@unique([channelAccountId, contactId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, assignedUserId])
  @@index([workspaceId, channelType])
  @@map("conversations")
}

model Message {
  id                String            @id @default(cuid())
  workspaceId       String            @map("workspace_id")
  conversationId    String            @map("conversation_id")
  externalMessageId String?           @unique @map("external_message_id")
  direction         MessageDirection
  senderType        MessageSenderType
  senderUserId      String?           @map("sender_user_id")
  agentRunId        String?           @map("agent_run_id")
  type              MessageType       @default(TEXT)
  text              String?
  payload           Json?
  status            MessageStatus     @default(QUEUED)
  errorCode         String?           @map("error_code")
  errorMessage      String?           @map("error_message")
  sentAt            DateTime?         @map("sent_at")
  deliveredAt       DateTime?         @map("delivered_at")
  readAt            DateTime?         @map("read_at")
  failedAt          DateTime?         @map("failed_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  media        MediaAsset?

  @@index([conversationId, createdAt])
  @@index([workspaceId, status])
  @@map("messages")
}

/// Estado de un adjunto recibido por un canal de mensajeria.
///
/// El proveedor entrega un identificador, no el archivo: hay una descarga
/// autenticada en medio que puede tardar, fallar o encontrarse con un medio ya
/// caducado. Cada uno de esos finales tiene que ser visible en la bandeja, no
/// un mensaje vacio.
enum MediaAssetStatus {
  PENDING
  DOWNLOADING
  STORED
  /// Tipo o tamano fuera de politica: no se descarga y no se reintenta.
  REJECTED
  /// El proveedor ya no lo tiene. No se reintenta.
  EXPIRED
  /// Falta configurar el almacenamiento. Se reintenta cuando exista.
  BLOCKED
  FAILED
  /// Borrado por politica de retencion; la fila queda como rastro.
  PURGED
}

/// Un archivo recibido en una conversacion, ya descargado y guardado por
/// nosotros. El identificador del proveedor caduca; el archivo no puede vivir
/// solo alli.
model MediaAsset {
  id             String           @id @default(cuid())
  workspaceId    String           @map("workspace_id")
  conversationId String?          @map("conversation_id")
  messageId      String?          @unique @map("message_id")
  provider       String           @default("whatsapp")
  externalMediaId String          @map("external_media_id")
  kind           MessageType
  status         MediaAssetStatus @default(PENDING)
  /// Tipo declarado por el proveedor: sirve para decidir, nunca para servir.
  declaredMime   String?          @map("declared_mime")
  /// Tipo con el que se guardo y con el que se sirve.
  mimeType       String?          @map("mime_type")
  /// La firma de los bytes confirmo el tipo. Solo lo confirmado se muestra
  /// dentro de la pagina; lo demas se descarga.
  contentConfirmed Boolean        @default(false) @map("content_confirmed")
  fileName       String?          @map("file_name")
  sizeBytes      Int?             @map("size_bytes")
  sha256         String?
  storageDriver  String?          @map("storage_driver")
  storageKey     String?          @map("storage_key")
  attempts       Int              @default(0)
  error          String?
  downloadedAt   DateTime?        @map("downloaded_at")
  expiresAt      DateTime?        @map("expires_at")
  purgedAt       DateTime?        @map("purged_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // SetNull y no Cascade a proposito: si el mensaje desaparece —al borrar un
  // contacto, por ejemplo— la fila tiene que sobrevivir para que alguien sepa
  // que quedo un archivo en el bucket y pueda borrarlo. Con Cascade el archivo
  // quedaria ahi para siempre sin nada que lo apunte.
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([status, expiresAt])
  @@index([provider, externalMediaId])
  @@map("media_assets")
}

/// Evento crudo recibido de un proveedor. El webhook solo persiste y encola;
/// el procesamiento ocurre despues. `dedupeKey` da idempotencia: una reentrega
/// del mismo evento no produce un segundo mensaje.
model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String
  dedupeKey   String             @map("dedupe_key")
  externalId  String?            @map("external_id")
  payload     Json
  status      WebhookEventStatus @default(PENDING)
  attempts    Int                @default(0)
  error       String?
  processedAt DateTime?          @map("processed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([provider, dedupeKey])
  @@index([status, createdAt])
  @@map("webhook_events")
}

/// Patron outbox: toda accion externa se persiste antes de intentarse, para que
/// una llamada fallida no deje la base y el proveedor en estados distintos.
model OutboxEvent {
  id             String       @id @default(cuid())
  workspaceId    String?      @map("workspace_id")
  type           OutboxType
  payload        Json
  idempotencyKey String       @unique @map("idempotency_key")
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at")
  processedAt    DateTime?    @map("processed_at")
  error          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// --- Fase 3: cola durable, scheduler y motor de automatizaciones -------------

/// Trabajo de la cola durable.
///
/// Se implementa como tabla en vez de pgmq para que Prisma la tipe, las pruebas
/// la consulten y la pagina de Ops muestre profundidad y antiguedad por
/// workspace sin SQL crudo. El reclamo usa `FOR UPDATE SKIP LOCKED`, que da la
/// misma garantia de "un solo consumidor por trabajo".
model Job {
  id          String    @id @default(cuid())
  workspaceId String?   @map("workspace_id")
  type        JobType
  payload     Json
  status      JobStatus @default(PENDING)
  priority    Int       @default(100)
  runAt       DateTime  @default(now()) @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lastError   String?   @map("last_error")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")

  /// Idempotencia al encolar: dos disparos del mismo hecho no crean dos trabajos.
  dedupeKey   String?   @unique @map("dedupe_key")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt, priority])
  @@index([workspaceId, status])
  @@map("jobs")
}

/// Ejecucion de una regla sobre un hecho concreto.
///
/// El unique (ruleId, dedupeKey) es lo que garantiza "una ejecucion por evento":
/// aunque el trabajo se reintente, la regla no vuelve a actuar.
model AutomationExecution {
  id          String                    @id @default(cuid())
  workspaceId String                    @map("workspace_id")
  ruleId      String                    @map("rule_id")
  dedupeKey   String                    @map("dedupe_key")
  contactId   String?                   @map("contact_id")
  status      AutomationExecutionStatus @default(MATCHED)
  actionsRun  Int                       @default(0) @map("actions_run")
  result      Json?
  error       String?
  createdAt   DateTime                  @default(now()) @map("created_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, dedupeKey])
  @@index([workspaceId, createdAt])
  @@map("automation_executions")
}

// --- Fase C: motor de flujos (Flow Builder) ---------------------------------
//
// AutomationRule (arriba) NO se toca ni se reemplaza: sigue siendo la via
// correcta para "si X entonces Y", que cubre la mayoria de casos reales sin
// necesitar un grafo. AutomationFlow es un segundo motor, para cuando la
// automatizacion es realmente una SECUENCIA de pasos con espera, ramas y
// pasos de IA — calcado del mismo patron de versionado que ya prueba
// AgentDefinition/AgentVersion/AgentRun (Fase 4): definicion estable, N
// versiones (DRAFT/PUBLISHED), y una tabla de ejecuciones que sobrevive un
// restart del proceso porque vive en la base, no en memoria.

enum AutomationFlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AutomationFlowRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

/// La definicion estable. `status` aqui es solo "activo/archivado" — el
/// DRAFT/PUBLISHED real vive en AutomationFlowVersion, exactamente como
/// AgentDefinition.isActive vs AgentVersion.status.
model AutomationFlow {
  id            String               @id @default(cuid())
  workspaceId   String               @map("workspace_id")
  name          String
  description   String?
  status        AutomationFlowStatus @default(DRAFT)
  channelScope  Channel[]            @default([]) @map("channel_scope")
  createdById   String?              @map("created_by")
  updatedById   String?              @map("updated_by")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  AutomationFlowVersion[]
  runs      AutomationFlowRun[]

  @@index([workspaceId, status])
  @@map("automation_flows")
}

/// Una version es INMUTABLE una vez PUBLISHED: editar crea una version nueva
/// en DRAFT (ver AutomationFlowStatus de mas arriba, no confundir con este
/// campo). `trigger`/`nodes`/`edges` son Json validados con Zod en
/// src/lib/automations/schema.ts, no tipados aqui — el grafo es datos, igual
/// que las reglas de PricingRuleSet o las condiciones de AutomationRule.
model AutomationFlowVersion {
  id               String                @id @default(cuid())
  flowId           String                @map("flow_id")
  version          Int
  status           AutomationFlowStatus  @default(DRAFT)
  trigger          Json
  nodes            Json
  edges            Json
  publishedAt      DateTime?             @map("published_at")
  // Metricas basicas (spec: "no analytics avanzados, pero registrar esto").
  runsStarted      Int                   @default(0) @map("runs_started")
  runsCompleted    Int                   @default(0) @map("runs_completed")
  runsFailed       Int                   @default(0) @map("runs_failed")
  messagesSent     Int                   @default(0) @map("messages_sent")
  checkoutsCreated Int                   @default(0) @map("checkouts_created")
  paymentsApproved Int                   @default(0) @map("payments_approved")
  handoffs         Int                   @default(0)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  flow AutomationFlow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runs AutomationFlowRun[]

  @@unique([flowId, version])
  @@index([flowId, status])
  @@map("automation_flow_versions")
}

/// El estado vivo de UNA ejecucion. Sobrevive un restart porque `currentNodeId`
/// y `state` (variables recolectadas durante el flujo: respuestas, tags
/// pendientes, etc.) se persisten en cada paso — el worker que retoma un run
/// en espera no necesita memoria de la corrida anterior, solo esta fila.
/// `depth` es la defensa contra loops de START_AUTOMATION (A llama a B que
/// llama a A): cada nodo START_AUTOMATION crea un run hijo con depth+1, y el
/// motor rechaza superar un limite fijo.
model AutomationFlowRun {
  id               String                  @id @default(cuid())
  workspaceId      String                  @map("workspace_id")
  flowId           String                  @map("flow_id")
  flowVersionId    String                  @map("flow_version_id")
  channel          Channel?
  contactId        String?                 @map("contact_id")
  conversationId   String?                 @map("conversation_id")
  triggerDedupeKey String?                 @map("trigger_dedupe_key")
  status           AutomationFlowRunStatus @default(RUNNING)
  currentNodeId    String?                 @map("current_node_id")
  state            Json?
  stepsExecuted    Int                     @default(0) @map("steps_executed")
  depth            Int                     @default(0)
  startedAt        DateTime                @default(now()) @map("started_at")
  waitingUntil     DateTime?               @map("waiting_until")
  endedAt          DateTime?               @map("ended_at")
  error            String?
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow        AutomationFlow        @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersion AutomationFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  contact     Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Idempotencia de arranque: el mismo evento disparador nunca crea dos runs
  // de la misma version. `triggerDedupeKey` puede ser null (un run manual/de
  // prueba no tiene evento que deduplicar).
  @@unique([flowVersionId, triggerDedupeKey])
  @@index([workspaceId, status])
  @@index([flowId, status])
  @@map("automation_flow_runs")
}

/// Plantilla instalable. Instalar NUNCA muta la plantilla: crea un
/// AutomationFlow + version DRAFT propios del workspace, con el mismo grafo
/// copiado. `requiredCapabilities` se compara contra
/// ChannelAccount.capabilities antes de permitir instalar/publicar.
model AutomationTemplate {
  id                   String   @id @default(cuid())
  key                  String   @unique
  name                 String
  description          String?
  supportedChannels    Channel[] @map("supported_channels")
  requiredCapabilities String[] @default([]) @map("required_capabilities")
  trigger              Json
  nodes                Json
  edges                Json
  requiredFields       Json?    @map("required_fields")
  tags                 String[] @default([])
  settings             Json?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("automation_templates")
}

// --- Fase 4: agentes IA ------------------------------------------------------

/// Agente de un workspace. La definicion es estable; lo que cambia son sus
/// versiones, para poder editar sin afectar lo que ya esta en produccion.
model AgentDefinition {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  key         AgentKind
  name        String
  purpose     String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  AgentVersion[]
  runs      AgentRun[]

  @@unique([workspaceId, key])
  @@map("agent_definitions")
}

/// Version de un agente: instrucciones, modelo, herramientas permitidas y
/// limites. Solo una puede estar PUBLISHED por agente; el resto queda como
/// historial o borrador. Publicar es una accion auditada, no un guardado.
model AgentVersion {
  id                String             @id @default(cuid())
  agentDefinitionId String             @map("agent_definition_id")
  version           Int
  instructions      String
  model             String
  /// temperature y demas opciones del proveedor.
  options           Json?
  /// Lista blanca de herramientas. Lo que no este aqui, el agente no puede usar.
  allowedTools      String[]           @default([]) @map("allowed_tools")
  maxSteps          Int                @default(6) @map("max_steps")
  /// Cuando debe escalar a un humano.
  escalationPolicy  Json?              @map("escalation_policy")
  status            AgentVersionStatus @default(DRAFT)
  createdById       String?            @map("created_by")
  publishedAt       DateTime?          @map("published_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  definition AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  runs       AgentRun[]

  @@unique([agentDefinitionId, version])
  @@index([agentDefinitionId, status])
  @@map("agent_versions")
}

/// Ejecucion de un agente. Guarda tokens, costo y latencia para poder medir el
/// gasto por workspace, que es la base del modelo comercial.
model AgentRun {
  id                String         @id @default(cuid())
  workspaceId       String         @map("workspace_id")
  conversationId    String?        @map("conversation_id")
  agentDefinitionId String         @map("agent_definition_id")
  agentVersionId    String         @map("agent_version_id")
  status            AgentRunStatus @default(RUNNING)
  trigger           String?
  inputSummary      String?        @map("input_summary")
  output            String?
  /// Cada tool call con sus argumentos y su resultado, para poder auditar que
  /// hizo el agente sin volver a llamarlo.
  toolCalls         Json?          @map("tool_calls")
  steps             Int            @default(0)
  inputTokens       Int            @default(0) @map("input_tokens")
  outputTokens      Int            @default(0) @map("output_tokens")
  costEstimate      Int            @default(0) @map("cost_estimate")
  latencyMs         Int            @default(0) @map("latency_ms")
  escalated         Boolean        @default(false)
  error             String?
  createdAt         DateTime       @default(now()) @map("created_at")

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  definition   AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  agentVersion AgentVersion    @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@map("agent_runs")
}

/// Estado del agente en una conversacion.
///
/// La base local es la fuente de verdad; `externalConversationId` es auxiliar y
/// puede perderse sin consecuencias. `lockedUntil` impide dos ejecuciones
/// simultaneas sobre la misma conversacion.
model ConversationAgentState {
  id                     String    @id @default(cuid())
  conversationId         String    @unique @map("conversation_id")
  currentAgentId         String?   @map("current_agent_id")
  externalConversationId String?   @map("external_conversation_id")
  state                  Json?
  summary                String?
  lastRunId              String?   @map("last_run_id")
  lockedUntil            DateTime? @map("locked_until")
  lockedBy               String?   @map("locked_by")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_agent_states")
}

// --- Fase 5: catalogo, ordenes y entrega digital -----------------------------

/// Conexion a un origen de catalogo. INTERNAL es el catalogo propio del CRM;
/// SHOPIFY llega en la Fase 6 y reusa esta misma tabla.
model CommerceConnection {
  id                   String           @id @default(cuid())
  workspaceId          String           @map("workspace_id")
  provider             CommerceProvider @default(INTERNAL)
  shopDomain           String?          @map("shop_domain")
  scopes               String[]         @default([])
  accessTokenEncrypted String?          @map("access_token_encrypted")
  status               String           @default("CONNECTED")
  lastSyncAt           DateTime?        @map("last_sync_at")
  metadata             Json?
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([workspaceId, provider])
  @@map("commerce_connections")
}

/// Credenciales de Mercado Pago de UN workspace, para cobrar SUS propios
/// productos (CustomerOrder/Payment). No confundir con MERCADO_PAGO_ACCESS_TOKEN
/// de entorno, que sigue siendo la cuenta de Upzites usada para cobrar la
/// suscripcion del CRM (src/lib/mercado-pago.ts mantiene ambos caminos por
/// separado a proposito).
///
/// Dos formas de llegar a CONNECTED, coexistiendo (Fase A2):
///  - OAUTH: el vendedor autoriza la aplicacion de Mercado Pago de Upzites
///    Flow (marketplace). Trae accessToken + refreshToken + vencimiento;
///    el webhook secret es el DE LA APLICACION (MERCADO_PAGO_WEBHOOK_SECRET),
///    no uno por fila — por eso webhookSecretEncrypted queda null aqui.
///  - MANUAL: el operador pega su propio access token y secreto de webhook
///    (Fase A original). Sigue disponible como modo avanzado/legacy.
model MercadoPagoConnection {
  id                      String                      @id @default(cuid())
  workspaceId             String                      @unique @map("workspace_id")
  connectionMethod        MercadoPagoConnectionMethod @default(MANUAL) @map("connection_method")
  mode                    MercadoPagoMode             @default(TEST)
  /// ID de usuario/vendedor de Mercado Pago (OAuth: `user_id` de la respuesta
  /// de token; MANUAL: se resuelve con GET /users/me al conectar). Es lo que
  /// el webhook compara contra `collector_id` del pago para atar cada
  /// notificacion a la cuenta correcta, incluso si alguien manipula la URL.
  mercadoPagoUserId       String?                     @map("mercado_pago_user_id")
  publicKey               String?                     @map("public_key")
  accessTokenEncrypted    String?                     @map("access_token_encrypted")
  /// Solo OAuth: null en conexiones MANUAL (no hay refresh token que pedir).
  refreshTokenEncrypted   String?                     @map("refresh_token_encrypted")
  accessTokenExpiresAt    DateTime?                   @map("access_token_expires_at")
  /// Solo MANUAL: en OAuth el secreto es el de la aplicacion (entorno), no de
  /// esta fila.
  webhookSecretEncrypted  String?                     @map("webhook_secret_encrypted")
  scopes                  String?
  status                  MercadoPagoConnectionStatus @default(DISCONNECTED)
  connectedAt             DateTime?                   @map("connected_at")
  lastRefreshAt           DateTime?                   @map("last_refresh_at")
  lastVerifiedAt          DateTime?                   @map("last_verified_at")
  lastErrorCode           String?                     @map("last_error_code")
  lastError               String?                     @map("last_error")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("mercado_pago_connections")
}

enum MercadoPagoConnectionMethod {
  OAUTH
  MANUAL
}

/// Distinto de IntegrationStatus (generico): REAUTH_REQUIRED no aplica a
/// WhatsApp/Shopify y no queremos que un `switch` de esos providers tenga
/// que contemplar un caso que nunca les corresponde.
enum MercadoPagoConnectionStatus {
  DISCONNECTED
  CONNECTED
  NEEDS_ATTENTION
  REAUTH_REQUIRED
}

model Product {
  id           String        @id @default(cuid())
  workspaceId  String        @map("workspace_id")
  connectionId String?       @map("connection_id")
  externalId   String?       @map("external_id")
  name         String
  description  String?
  type         ProductType   @default(DIGITAL)
  status       ProductStatus @default(DRAFT)
  currency     String        @default("CLP")
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection CommerceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  assets     DigitalAsset[]

  @@unique([connectionId, externalId])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@map("products")
}

/// Variante vendible. Un producto simple tiene una sola, marcada `isDefault`.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  externalId String?  @map("external_id")
  name       String
  sku        String?
  priceClp   Int      @map("price_clp")
  /// Null significa "sin control de stock" (tipico de un digital).
  inventory  Int?
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines   OrderLine[]

  @@unique([productId, externalId])
  @@index([productId, isActive])
  @@map("product_variants")
}

/// Lo que se entrega al comprar un digital: un archivo, un enlace o un codigo.
model DigitalAsset {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  productId   String           @map("product_id")
  kind        DigitalAssetKind @default(LINK)
  name        String
  /// Para LINK: la URL de destino. Para FILE: la clave en el almacenamiento.
  target      String
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  deliveries DigitalDelivery[]

  @@index([workspaceId, productId])
  @@map("digital_assets")
}

/// Pedido de un cliente. Guarda snapshot de cada linea: el precio de hoy no
/// puede depender de que el producto siga existiendo manana con ese valor.
model CustomerOrder {
  id             String           @id @default(cuid())
  workspaceId    String           @map("workspace_id")
  provider       CommerceProvider @default(INTERNAL)
  externalId     String?          @map("external_id")
  contactId      String?          @map("contact_id")
  conversationId String?          @map("conversation_id")
  status         OrderStatus      @default(DRAFT)
  currency       String           @default("CLP")
  subtotal       Int              @default(0)
  discount       Int              @default(0)
  total          Int              @default(0)
  customerEmail  String?          @map("customer_email")
  customerName   String?          @map("customer_name")
  notes          String?
  metadata       Json?
  confirmedAt    DateTime?        @map("confirmed_at")
  cancelledAt    DateTime?        @map("cancelled_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lines        OrderLine[]
  payments     Payment[]
  fulfillments FulfillmentOrder[]
  deliveries   DigitalDelivery[]

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, contactId])
  @@map("customer_orders")
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  variantId String? @map("variant_id")
  /// Snapshot: nombre, sku y precio unitario al momento de la compra.
  name      String
  sku       String?
  unitPrice Int     @map("unit_price")
  quantity  Int     @default(1)
  total     Int

  order   CustomerOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_lines")
}

/// Pago recibido. `externalId` unico global: es lo que hace idempotente el
/// webhook, aunque Mercado Pago reintente diez veces.
model Payment {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  orderId     String?         @map("order_id")
  provider    PaymentProvider @default(MERCADO_PAGO)
  externalId  String          @unique @map("external_id")
  status      PaymentStatus   @default(PENDING)
  rawStatus   String?         @map("raw_status")
  amount      Int
  currency    String          @default("CLP")
  payerEmail  String?         @map("payer_email")
  metadata    Json?
  approvedAt  DateTime?       @map("approved_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@map("payments")
}

model FulfillmentOrder {
  id          String            @id @default(cuid())
  orderId     String            @map("order_id")
  type        FulfillmentType   @default(DIGITAL)
  status      FulfillmentStatus @default(PENDING)
  trackingUrl String?           @map("tracking_url")
  metadata    Json?
  deliveredAt DateTime?         @map("delivered_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@map("fulfillment_orders")
}

/// Acceso concedido a un asset digital.
///
/// El token se guarda hasheado, igual que las contrasenas: quien lea la base no
/// obtiene accesos utilizables. El unique (orderId, assetId) es lo que hace
/// idempotente la entrega: un pago reintentado no genera un segundo acceso.
model DigitalDelivery {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  orderId       String         @map("order_id")
  assetId       String         @map("asset_id")
  contactId     String?        @map("contact_id")
  tokenHash     String         @unique @map("token_hash")
  status        DeliveryStatus @default(GRANTED)
  expiresAt     DateTime?      @map("expires_at")
  maxDownloads  Int            @default(20) @map("max_downloads")
  downloadCount Int            @default(0) @map("download_count")
  lastAccessAt  DateTime?      @map("last_access_at")
  sentAt        DateTime?      @map("sent_at")
  /// Cuando se revoco el acceso. Ante una disputa, saber el momento importa
  /// tanto como saber que se revoco.
  revokedAt     DateTime?      @map("revoked_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  asset     DigitalAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([orderId, assetId])
  @@index([workspaceId, createdAt])
  @@map("digital_deliveries")
}

// --- Fase 7: cotizador y aprobaciones ----------------------------------------

/// Reglas de precio de un servicio, versionadas.
///
/// `intakeSchema` define QUE datos hay que pedirle al cliente y `rules` COMO se
/// calcula. Ambos son JSON validado con Zod, no codigo: cada workspace define
/// su propio servicio sin que haya que tocar el producto. La beta es
/// multivertical; mallas de seguridad es una configuracion, no una feature.
model PricingRuleSet {
  id           String               @id @default(cuid())
  workspaceId  String               @map("workspace_id")
  serviceKey   String               @map("service_key")
  name         String
  description  String?
  version      Int                  @default(1)
  currency     String               @default("CLP")
  /// Campos que el agente debe recolectar antes de poder calcular.
  intakeSchema Json                 @map("intake_schema")
  /// Componentes de calculo: base, recargos, descuentos, minimo y redondeo.
  rules        Json
  disclaimer   String?
  validityDays Int                  @default(15) @map("validity_days")
  status       PricingRuleSetStatus @default(DRAFT)
  publishedAt  DateTime?            @map("published_at")
  createdById  String?              @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotes    Quote[]

  @@unique([workspaceId, serviceKey, version])
  @@index([workspaceId, status])
  @@map("pricing_rule_sets")
}

/// Cotizacion calculada.
///
/// Guarda los datos de entrada y el desglose completo: una cotizacion aprobada
/// tiene que poder reconstruirse anos despues aunque las reglas hayan cambiado.
model Quote {
  id             String      @id @default(cuid())
  workspaceId    String      @map("workspace_id")
  contactId      String?     @map("contact_id")
  opportunityId  String?     @map("opportunity_id")
  conversationId String?     @map("conversation_id")
  ruleSetId      String      @map("rule_set_id")
  serviceKey     String      @map("service_key")

  /// Numero legible para el cliente: COT-0001.
  number  String
  version Int    @default(1)
  /// Version anterior, cuando esta cotizacion la reemplaza.
  parentQuoteId String? @map("parent_quote_id")

  /// Datos que entrego el cliente, ya validados contra el intakeSchema.
  inputs     Json
  subtotal   Int
  surcharges Int         @default(0)
  discounts  Int         @default(0)
  total      Int
  currency   String      @default("CLP")
  disclaimer String?
  validUntil DateTime?   @map("valid_until")
  status     QuoteStatus @default(DRAFT)

  reviewerId String?   @map("reviewer_id")
  reviewedAt DateTime? @map("reviewed_at")
  reviewNote String?   @map("review_note")
  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")
  rejectedAt DateTime? @map("rejected_at")

  /// Token del PDF publico. Se guarda hasheado, como el de las entregas.
  pdfTokenHash String?  @unique @map("pdf_token_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ruleSet   PricingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  parent    Quote?         @relation("QuoteVersions", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  revisions Quote[]        @relation("QuoteVersions")
  lines     QuoteLine[]

  @@unique([workspaceId, number, version])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, contactId])
  @@map("quotes")
}

/// Linea del desglose. Es el "por que" del total.
model QuoteLine {
  id       String        @id @default(cuid())
  quoteId  String        @map("quote_id")
  kind     QuoteLineKind
  label    String
  detail   String?
  amount   Int
  position Int           @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@map("quote_lines")
}

/// Solicitud de aprobacion humana.
///
/// Generica a proposito: hoy la usan las cotizaciones, pero sirve para
/// cualquier recurso que necesite revision antes de salir.
model ApprovalRequest {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  resourceType  String         @map("resource_type")
  resourceId    String         @map("resource_id")
  type          ApprovalType   @default(QUOTE_REVIEW)
  status        ApprovalStatus @default(PENDING)
  requestedById String?        @map("requested_by")
  requestedNote String?        @map("requested_note")
  approverId    String?        @map("approver_id")
  comment       String?
  dueAt         DateTime?      @map("due_at")
  resolvedAt    DateTime?      @map("resolved_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, status])
  @@index([workspaceId, status, createdAt])
  @@map("approval_requests")
}

// --- Fase 8: recuperacion, email y campanas -----------------------------------

/// Politica de contacto del workspace: zona horaria, ventana de silencio y
/// topes de frecuencia.
///
/// Es 1:1 con el workspace y arranca con los valores de la spec (seccion 11),
/// de modo que un workspace recien creado ya queda protegido contra envios
/// indebidos sin que nadie configure nada.
model MessagingPolicy {
  id          String @id @default(cuid())
  workspaceId String @unique @map("workspace_id")

  /// Zona IANA. Las quiet hours se evaluan aqui, no en la del servidor.
  timezone String @default("America/Santiago")

  /// Minutos desde medianoche. Por defecto 20:30 a 09:00.
  quietStartMinute Int @default(1230) @map("quiet_start_minute")
  quietEndMinute   Int @default(540) @map("quiet_end_minute")

  /// Topes de frecuencia. Solo los consume lo promocional: un mensaje
  /// operativo de una compra nunca queda bloqueado por un tope de marketing.
  maxWhatsappPerDay     Int @default(1) @map("max_whatsapp_per_day")
  maxEmailPerWeek       Int @default(3) @map("max_email_per_week")
  maxConsecutiveNoReply Int @default(3) @map("max_consecutive_no_reply")

  /// Regla 9 de la spec: no enviar WhatsApp y email promocional el mismo dia
  /// salvo que el workspace lo habilite a proposito.
  allowSameDayMultichannel Boolean @default(false) @map("allow_same_day_multichannel")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("messaging_policies")
}

/// Segmento de contactos: un filtro declarativo, no una lista materializada.
///
/// El recuento guardado es informativo. Toda campana reevalua el segmento en el
/// momento del envio, para que nadie reciba algo por estar en una lista vieja.
model Segment {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  key         String
  name        String
  description String?
  source      SegmentSource @default(PRESET)

  /// Filtro validado con Zod. Ver src/lib/marketing/segments.ts.
  definition Json

  estimatedCount  Int       @default(0) @map("estimated_count")
  lastEvaluatedAt DateTime? @map("last_evaluated_at")
  isActive        Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  journeys  Journey[]

  @@unique([workspaceId, key])
  @@index([workspaceId, isActive])
  @@map("segments")
}

/// Secuencia de seguimiento. Los pasos y sus esperas son datos: un rubro nuevo
/// configura su recuperacion sin desplegar codigo.
model Journey {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  key         String
  name        String
  description String?
  status      JourneyStatus  @default(DRAFT)
  trigger     JourneyTrigger

  /// Ademas del disparador, el contacto debe pertenecer a este segmento.
  segmentId String? @map("segment_id")

  entryConditions Json? @map("entry_conditions")
  exitConditions  Json? @map("exit_conditions")

  version     Int       @default(1)
  publishedAt DateTime? @map("published_at")
  pausedAt    DateTime? @map("paused_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  segment       Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  steps         JourneyStep[]
  enrollments   JourneyEnrollment[]
  emailMessages EmailMessage[]
  sendLogs      ContactSendLog[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@map("journeys")
}

model JourneyStep {
  id        String            @id @default(cuid())
  journeyId String            @map("journey_id")
  position  Int
  label     String
  action    JourneyStepAction

  /// Espera desde el paso anterior; en el primero, desde la inscripcion.
  delayHours Float @default(0) @map("delay_hours")

  channel    ConsentChannel?
  templateId String?         @map("template_id")

  /// Cuerpo para WhatsApp, o para email sin template.
  body       String?
  conditions Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journey  Journey        @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([journeyId, position])
  @@map("journey_steps")
}

/// Inscripcion de un contacto en un journey.
///
/// `@@unique([journeyId, contactId])` es deliberado: en la beta un contacto
/// entra una sola vez a cada journey. Reinscribir es una decision de producto
/// (la spec la deja como "reactivacion futura configurable"), y mientras no
/// exista, la unicidad impide que un barrido repetido vuelva a escribirle.
model JourneyEnrollment {
  id          String                  @id @default(cuid())
  workspaceId String                  @map("workspace_id")
  journeyId   String                  @map("journey_id")
  contactId   String                  @map("contact_id")
  status      JourneyEnrollmentStatus @default(ACTIVE)

  currentPosition Int       @default(0) @map("current_position")
  nextRunAt       DateTime? @map("next_run_at")

  /// Clave con la que se cancelan de una vez las acciones de esta inscripcion.
  cancelKey String @map("cancel_key")

  stepsCompleted Int       @default(0) @map("steps_completed")
  enteredAt      DateTime  @default(now()) @map("entered_at")
  exitedAt       DateTime? @map("exited_at")
  exitReason     String?   @map("exit_reason")
  lastError      String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  journey   Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([journeyId, contactId])
  @@index([workspaceId, status])
  @@index([status, nextRunAt])
  @@map("journey_enrollments")
}

/// Dominio de envio del cliente. Sin un dominio verificado no sale email
/// promocional: enviar desde un dominio ajeno arruina la reputacion de todos.
model EmailDomain {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  domain      String
  provider    EmailProviderKind @default(SCRIPTED)
  status      EmailDomainStatus @default(PENDING)

  /// Registros DNS que el cliente debe publicar. Los entrega el proveedor.
  dnsRecords       Json?   @map("dns_records")
  providerDomainId String? @map("provider_domain_id")

  fromName  String? @map("from_name")
  fromEmail String? @map("from_email")

  verifiedAt    DateTime? @map("verified_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastError     String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@index([workspaceId, status])
  @@map("email_domains")
}

/// Plantilla de email.
///
/// `aiSlots` declara los unicos huecos que la IA puede rellenar. El asunto, la
/// estructura y los enlaces son del template: la personalizacion no reescribe
/// el mensaje, solo completa lo que el template le dejo completar.
model EmailTemplate {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  key         String
  name        String
  subject     String
  bodyHtml    String              @map("body_html")
  bodyText    String              @map("body_text")
  variables   String[]            @default([])
  aiSlots     Json?               @map("ai_slots")
  category    SendCategory        @default(PROMOTIONAL)
  status      EmailTemplateStatus @default(DRAFT)
  publishedAt DateTime?           @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  journeySteps  JourneyStep[]
  emailMessages EmailMessage[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@map("email_templates")
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  name        String
  channel     ConsentChannel @default(EMAIL)
  segmentId   String?        @map("segment_id")
  templateId  String?        @map("template_id")
  status      CampaignStatus @default(DRAFT)

  scheduledAt DateTime? @map("scheduled_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// Contadores materializados: la vista de metricas no recorre destinatarios.
  recipientCount    Int @default(0) @map("recipient_count")
  sentCount         Int @default(0) @map("sent_count")
  skippedCount      Int @default(0) @map("skipped_count")
  failedCount       Int @default(0) @map("failed_count")
  deliveredCount    Int @default(0) @map("delivered_count")
  openedCount       Int @default(0) @map("opened_count")
  clickedCount      Int @default(0) @map("clicked_count")
  bouncedCount      Int @default(0) @map("bounced_count")
  complainedCount   Int @default(0) @map("complained_count")
  unsubscribedCount Int @default(0) @map("unsubscribed_count")

  createdById String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  segment       Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  template      EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients    CampaignRecipient[]
  emailMessages EmailMessage[]
  sendLogs      ContactSendLog[]

  @@index([workspaceId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id          String                  @id @default(cuid())
  workspaceId String                  @map("workspace_id")
  campaignId  String                  @map("campaign_id")
  contactId   String                  @map("contact_id")
  status      CampaignRecipientStatus @default(PENDING)

  /// Por que no se le envio. Es la evidencia de que la omision fue deliberada.
  skipReason     String?   @map("skip_reason")
  emailMessageId String?   @unique @map("email_message_id")
  processedAt    DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([workspaceId, status])
  @@map("campaign_recipients")
}

model EmailMessage {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  contactId   String? @map("contact_id")
  campaignId  String? @map("campaign_id")
  journeyId   String? @map("journey_id")
  templateId  String? @map("template_id")

  toEmail   String @map("to_email")
  fromEmail String @map("from_email")
  subject   String
  bodyHtml  String @map("body_html")
  bodyText  String @map("body_text")

  category SendCategory       @default(PROMOTIONAL)
  status   EmailMessageStatus @default(QUEUED)
  provider EmailProviderKind  @default(SCRIPTED)

  providerMessageId String? @map("provider_message_id")

  /// Solo el hash del token de baja: el enlace se arma una vez y el CRM nunca
  /// guarda con que se puede dar de baja a alguien.
  unsubscribeTokenHash String? @unique @map("unsubscribe_token_hash")

  sentAt         DateTime? @map("sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  openedAt       DateTime? @map("opened_at")
  clickedAt      DateTime? @map("clicked_at")
  bouncedAt      DateTime? @map("bounced_at")
  complainedAt   DateTime? @map("complained_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  failedAt       DateTime? @map("failed_at")
  lastError      String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign  Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  journey   Journey?           @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  template  EmailTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  events    EmailEvent[]
  recipient CampaignRecipient?

  @@index([workspaceId, status])
  @@index([workspaceId, contactId])
  @@index([workspaceId, providerMessageId])
  @@map("email_messages")
}

/// Hecho reportado por el proveedor de email. `dedupeKey` hace idempotente el
/// webhook: el mismo evento reintentado no cuenta dos veces.
model EmailEvent {
  id             String         @id @default(cuid())
  workspaceId    String         @map("workspace_id")
  emailMessageId String?        @map("email_message_id")
  type           EmailEventType
  dedupeKey      String         @map("dedupe_key")
  payload        Json?
  occurredAt     DateTime       @default(now()) @map("occurred_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, type, occurredAt])
  @@map("email_events")
}

/// Registro de envios por contacto y canal.
///
/// Existe para aplicar los topes de frecuencia sin recorrer mensajes ni emails,
/// y para poder responder "cuando fue la ultima vez que le escribimos" con una
/// sola consulta.
model ContactSendLog {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  contactId   String         @map("contact_id")
  channel     ConsentChannel
  category    SendCategory   @default(PROMOTIONAL)
  journeyId   String?        @map("journey_id")
  campaignId  String?        @map("campaign_id")
  sentAt      DateTime       @default(now()) @map("sent_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  journey   Journey?  @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, contactId, channel, sentAt])
  @@index([workspaceId, sentAt])
  @@map("contact_send_logs")
}

// --- Fase 9: onboarding, planes y consumo ------------------------------------

/// Perfil comercial del workspace: lo que el wizard recoge y el resto del CRM
/// necesita saber para comportarse distinto sin que nadie toque codigo.
///
/// `businessType` es la unica pieza que cambia que se le pide a un cliente
/// —infoproducto, ecommerce o servicios—. No cambia la logica: cambia que
/// pasos del onboarding son obligatorios y que capacidades tiene sentido
/// activar. La beta es multivertical y esto es lo mas cerca que esta de
/// reconocer un rubro: tres formas de vender, no tres rubros.
model WorkspaceProfile {
  id          String       @id @default(cuid())
  workspaceId String       @unique @map("workspace_id")

  businessType BusinessType @default(UNDEFINED) @map("business_type")
  /// Rubro declarado por el cliente. Es independiente de `businessType`, que
  /// describe la modalidad de venta y condiciona el onboarding.
  industry      String?
  industryOther String?      @map("industry_other")
  currency     String       @default("CLP")
  country      String       @default("CL")

  /// Horario de atencion humana. Minutos desde medianoche, en la zona de
  /// `MessagingPolicy`.
  businessStartMinute Int   @default(540) @map("business_start_minute")
  businessEndMinute   Int   @default(1080) @map("business_end_minute")
  /// Dias habiles: 1 = lunes ... 7 = domingo.
  businessDays        Int[] @default([1, 2, 3, 4, 5]) @map("business_days")

  /// Lo que el agente puede decir del negocio. Es conocimiento, no prompt: se
  /// inyecta como contexto y no reemplaza las instrucciones del agente.
  about           String?
  policies        String?
  shippingInfo    String? @map("shipping_info")
  returnsPolicy   String? @map("returns_policy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_profiles")
}

/// Estado de activacion del workspace.
///
/// Guarda SOLO lo que no se puede deducir del resto del sistema: cuando se
/// activo y quien lo hizo. El avance del wizard NO se guarda: se calcula
/// mirando el estado real (hay canal conectado? hay agente publicado?). Un
/// checklist con casillas guardadas miente en cuanto alguien desconecta algo.
model WorkspaceActivation {
  id          String           @id @default(cuid())
  workspaceId String           @unique @map("workspace_id")
  status      ActivationStatus @default(ONBOARDING)

  activatedAt   DateTime? @map("activated_at")
  activatedById String?   @map("activated_by")
  /// Motivo por el que se suspendio o volvio a onboarding.
  note          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_activations")
}

/// Contador de consumo por periodo.
///
/// Existe aparte de `UsageRecord` por una razon de forma: comprobar un limite
/// tiene que costar la lectura de una fila, no sumar un mes de registros. El
/// detalle vive en `UsageRecord` para poder auditar; el contador es lo que se
/// consulta antes de cada envio, cada inferencia y cada contacto nuevo.
model UsageCounter {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  /// Periodo `YYYY-MM`. Los limites del plan son mensuales.
  period      String
  metric      String

  quantity Int @default(0)
  costClp  Int @default(0) @map("cost_clp")

  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period, metric])
  @@index([workspaceId, period])
  @@map("usage_counters")
}

/// Aviso operativo dirigido al cliente: una integracion que se cayo, un limite
/// que se acerca, un plan vencido.
///
/// Se guarda en vez de calcularse al vuelo porque hace falta saber si ya se
/// aviso: repetir el mismo aviso cada cinco minutos consigue que se ignoren
/// todos.
model WorkspaceAlert {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  kind        AlertKind
  severity    AlertSeverity @default(WARNING)

  title   String
  detail  String?
  /// Identifica el motivo del aviso. Unico mientras sigue abierto.
  dedupeKey String @map("dedupe_key")

  resolvedAt   DateTime? @map("resolved_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedById String? @map("acknowledged_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, resolvedAt])
  @@map("workspace_alerts")
}

/// Suscripción Web Push de un usuario en un navegador concreto. El endpoint y
/// las claves son credenciales de entrega: solo se usan en el servidor.
model PushSubscription {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  endpoint    String @unique
  p256dh      String
  auth        String

  deviceLabel String?   @map("device_label")
  userAgent   String?   @map("user_agent")
  expiresAt   DateTime? @map("expires_at")
  enabled     Boolean   @default(true)

  notifyHumanAttention   Boolean @default(true) @map("notify_human_attention")
  notifyAssigned         Boolean @default(true) @map("notify_assigned")
  notifyQuoteApproval    Boolean @default(true) @map("notify_quote_approval")
  notifyOperationalIssue Boolean @default(true) @map("notify_operational_issue")
  notifyIncomingMessage  Boolean @default(true) @map("notify_incoming_message")

  failureCount  Int       @default(0) @map("failure_count")
  lastSuccessAt DateTime? @map("last_success_at")
  disabledAt    DateTime? @map("disabled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, enabled])
  @@map("push_subscriptions")
}

// --- Fase 10: hardening y lanzamiento ----------------------------------------

/// Interruptor de una funcion, global o de un workspace.
///
/// Es el freno de mano que pide la spec: "forma rapida de apagar IA o campanas
/// sin detener el CRM". Apagar `AI_AGENTS` deja el inbox, los contactos y los
/// pedidos funcionando; solo el agente deja de responder.
///
/// `scope` vale `GLOBAL` o el id del workspace. Es una columna aparte y no el
/// `workspaceId` nullable porque en Postgres dos NULL son distintos entre si:
/// un unique sobre (workspaceId, key) dejaria crear dos interruptores globales
/// contradictorios para la misma funcion.
model FeatureFlag {
  id          String  @id @default(cuid())
  scope       String
  workspaceId String? @map("workspace_id")
  key         String
  enabled     Boolean @default(true)
  /// Por que se apago. Se muestra en la interfaz de operaciones.
  note        String?

  updatedById String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([scope, key])
  @@index([key, enabled])
  @@map("feature_flags")
}

/// Contador de una ventana de rate limiting.
///
/// Vive en la base y no en memoria porque el CRM corre en funciones sin estado:
/// un contador en memoria protegeria una instancia y dejaria pasar el ataque
/// por la de al lado.
///
/// El precio es una escritura por peticion en los endpoints protegidos. Se
/// acepta: son login, captura publica y webhooks, no el trafico normal.
model RateLimitWindow {
  id     String @id @default(cuid())
  /// Identifica al limitado: `login:<ip>`, `capture:<formId>`, etc.
  bucket String
  /// Inicio de la ventana, truncado. Dos peticiones de la misma ventana
  /// comparten fila.
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_windows")
}

