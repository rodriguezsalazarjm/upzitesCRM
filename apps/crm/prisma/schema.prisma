generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  publicKey String   @unique @default(cuid()) @map("public_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  companies       Company[]
  contacts        Contact[]
  pipelineStages  PipelineStage[]
  opportunities   Opportunity[]
  activities      Activity[]
  leadSources     LeadSource[]
  forms           Form[]
  formSubmissions FormSubmission[]
  webEvents       WebEvent[]
  integrations    Integration[]
  automationRules AutomationRule[]
  aiInsights      AiInsight[]
  auditLogs       AuditLog[]
  subscriptions   WorkspaceSubscription[]

  contactConsents    ContactChannelConsent[]
  suppressionEntries SuppressionEntry[]
  leadScoreRules     LeadScoreRule[]
  leadScoreSnapshots LeadScoreSnapshot[]
  scheduledActions   ScheduledAction[]
  usageRecords       UsageRecord[]

  whatsappChannels WhatsAppChannel[]
  conversations    Conversation[]
  messages         Message[]
  outboxEvents     OutboxEvent[]

  jobs                 Job[]
  automationExecutions AutomationExecution[]

  agentDefinitions AgentDefinition[]
  agentRuns        AgentRun[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  name         String
  email        String
  passwordHash String   @map("password_hash")
  role         UserRole @default(SALES)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownedOpportunities  Opportunity[]        @relation("OpportunityOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  createdActivities   Activity[]           @relation("ActivityCreator")
  passwordResetTokens PasswordResetToken[]
  assignedConversations Conversation[]     @relation("ConversationAssignee")
  sentMessages          Message[]          @relation("MessageSender")

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Company {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  website     String?
  industry    String?
  size        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  opportunities Opportunity[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("companies")
}

model Contact {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  companyId      String?       @map("company_id")
  ownerId        String?       @map("owner_id")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String?
  phone          String?
  status         ContactStatus @default(LEAD)
  source         String?
  utmSource      String?       @map("utm_source")
  utmMedium      String?       @map("utm_medium")
  utmCampaign    String?       @map("utm_campaign")
  value          Int           @default(0)
  tags           String[]      @default([])
  lastActivityAt DateTime?     @map("last_activity_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Dimensiones independientes del estado comercial. `status` (ContactStatus)
  // se mantiene por compatibilidad con la UI y las rutas actuales; la fuente de
  // verdad del ciclo de vida es `lifecycleStatus`. Ver src/lib/domain/lifecycle.ts.
  lifecycleStatus LifecycleStatus @default(LEAD) @map("lifecycle_status")
  temperature     LeadTemperature @default(COLD)
  buyingIntent    BuyingIntent    @default(UNKNOWN) @map("buying_intent")
  leadScore       Int             @default(0) @map("lead_score")
  scoreUpdatedAt  DateTime?       @map("score_updated_at")

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner            User?                  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  opportunities    Opportunity[]
  activities       Activity[]
  formSubmissions  FormSubmission[]
  aiInsights       AiInsight[]
  consents         ContactChannelConsent[]
  scoreSnapshots   LeadScoreSnapshot[]
  scheduledActions ScheduledAction[]
  conversations    Conversation[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, lifecycleStatus])
  @@index([workspaceId, temperature])
  @@map("contacts")
}

model PipelineStage {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  key         OpportunityStage
  name        String
  position    Int
  probability Int
  isWon       Boolean          @default(false) @map("is_won")
  isLost      Boolean          @default(false) @map("is_lost")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
  @@map("pipeline_stages")
}

model Opportunity {
  id                String            @id @default(cuid())
  workspaceId       String            @map("workspace_id")
  contactId         String?           @map("contact_id")
  companyId         String?           @map("company_id")
  stageId           String            @map("stage_id")
  ownerId           String?           @map("owner_id")
  title             String
  value             Int               @default(0)
  probability       Int
  expectedCloseDate DateTime?         @map("expected_close_date")
  status            OpportunityStatus @default(OPEN)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner      User?         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]
  aiInsights AiInsight[]

  @@index([workspaceId, status])
  @@index([workspaceId, stageId])
  @@map("opportunities")
}

model Activity {
  id            String       @id @default(cuid())
  workspaceId   String       @map("workspace_id")
  contactId     String?      @map("contact_id")
  opportunityId String?      @map("opportunity_id")
  createdById   String?      @map("created_by")
  type          ActivityType
  title         String
  description   String?
  dueAt         DateTime?    @map("due_at")
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, type])
  @@map("activities")
}

model LeadSource {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@map("lead_sources")
}

model Form {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  publicId    String   @unique @default(cuid()) @map("public_id")
  name        String
  title       String
  description String?
  submitLabel String   @default("Enviar") @map("submit_label")
  source      String   @default("Formulario web")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([workspaceId])
  @@map("forms")
}

model FormSubmission {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  formId      String   @map("form_id")
  contactId   String?  @map("contact_id")
  payload     Json
  pageUrl     String?  @map("page_url")
  referrer    String?
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([formId])
  @@map("form_submissions")
}

model WebEvent {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  type        WebEventType
  pageUrl     String       @map("page_url")
  referrer    String?
  element     String?
  formId      String?      @map("form_id")
  contactId   String?      @map("contact_id")
  visitorId   String?      @map("visitor_id")
  sessionId   String?      @map("session_id")
  utmSource   String?      @map("utm_source")
  utmMedium   String?      @map("utm_medium")
  utmCampaign String?      @map("utm_campaign")
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, createdAt])
  @@index([workspaceId, pageUrl])
  @@map("web_events")
}

model Integration {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  provider    IntegrationProvider
  name        String
  status      IntegrationStatus   @default(DISCONNECTED)
  config      Json?
  lastSyncAt  DateTime?           @map("last_sync_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
  @@map("integrations")
}

model AutomationRule {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  name        String
  description String?
  trigger     AutomationTrigger
  isActive    Boolean           @default(true) @map("is_active")

  /// Grupo de condiciones validado con Zod: { match: "ALL" | "ANY", rules: [...] }.
  /// Null significa "sin condiciones": la regla corre en cada disparo.
  conditions Json?

  /// Lista de acciones a ejecutar en orden, validada con Zod.
  /// Reemplaza al par action/actionConfig, que queda solo por compatibilidad.
  actions Json?

  /// Deprecados: los conserva una regla creada antes de la Fase 3.
  action       AutomationAction?
  actionConfig Json?             @map("action_config")

  /// Ventana de deduplicacion por contacto, en minutos. Evita que un mismo
  /// contacto dispare la misma regla dos veces seguidas.
  dedupeMinutes Int       @default(0) @map("dedupe_minutes")
  lastRunAt     DateTime? @map("last_run_at")
  runCount      Int       @default(0) @map("run_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, trigger, isActive])
  @@map("automation_rules")
}

model AiInsight {
  id            String        @id @default(cuid())
  workspaceId   String        @map("workspace_id")
  contactId     String?       @map("contact_id")
  opportunityId String?       @map("opportunity_id")
  type          AiInsightType
  title         String
  description   String
  score         Int?
  status        InsightStatus @default(OPEN)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@map("ai_insights")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  priceClp    Int      @map("price_clp")
  maxUsers    Int      @map("max_users")
  maxContacts Int      @map("max_contacts")
  features    String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")

  subscriptions WorkspaceSubscription[]

  @@map("subscription_plans")
}

model WorkspaceSubscription {
  id             String             @id @default(cuid())
  workspaceId    String             @map("workspace_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(TRIAL)
  trialEndsAt    DateTime?          @map("trial_ends_at")
  renewsAt       DateTime?          @map("renews_at")
  mpPreferenceId String?            @map("mp_preference_id")
  mpPaymentId    String?            @unique @map("mp_payment_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@map("workspace_subscriptions")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  actorId     String?  @map("actor_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

/// Consentimiento por canal. Es independiente para WhatsApp, email y publicidad:
/// aceptar recibir la confirmacion de una compra no habilita marketing.
model ContactChannelConsent {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  contactId   String        @map("contact_id")
  channel     ConsentChannel
  status      ConsentStatus @default(UNKNOWN)
  source      String?
  evidence    Json?
  grantedAt   DateTime?     @map("granted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channel])
  @@index([workspaceId, channel, status])
  @@map("contact_channel_consents")
}

/// Lista de supresion a nivel de workspace. Sobrevive al borrado del contacto y
/// a una reimportacion por CSV: la identidad es el email o telefono normalizado.
model SuppressionEntry {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  channel     ConsentChannel
  identifier  String
  reason      SuppressionReason @default(USER_REQUEST)
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channel, identifier])
  @@index([workspaceId, channel])
  @@map("suppression_entries")
}

/// Reglas de scoring versionadas por workspace. El score es calculado y
/// explicable: nunca reemplaza la etapa del pipeline.
model LeadScoreRule {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  key         String
  label       String
  points      Int
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, isActive])
  @@map("lead_score_rules")
}

/// Foto del score en un momento dado, con las razones que lo produjeron.
model LeadScoreSnapshot {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  contactId   String          @map("contact_id")
  score       Int
  temperature LeadTemperature
  reasons     Json
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactId, createdAt])
  @@map("lead_score_snapshots")
}

/// Accion diferida (seguimiento, recordatorio, recuperacion). `cancelKey` agrupa
/// las acciones de un mismo motivo para poder cancelarlas de una sola vez cuando
/// el contacto responde, paga o revoca el consentimiento.
model ScheduledAction {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  contactId   String?               @map("contact_id")
  type        ScheduledActionType
  status      ScheduledActionStatus @default(PENDING)
  payload     Json?
  cancelKey   String?               @map("cancel_key")
  runAt       DateTime              @map("run_at")
  attempts    Int                   @default(0)
  lastError   String?               @map("last_error")
  processedAt DateTime?             @map("processed_at")
  canceledAt  DateTime?             @map("canceled_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([workspaceId, cancelKey])
  @@index([workspaceId, contactId])
  @@map("scheduled_actions")
}

/// Consumo medido por workspace (mensajes, tokens de IA, emails). Base para los
/// limites de plan y los excedentes.
model UsageRecord {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  provider      String
  metric        String
  quantity      Int
  costEstimate  Int      @default(0) @map("cost_estimate")
  currency      String   @default("CLP")
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric, occurredAt])
  @@index([workspaceId, provider])
  @@map("usage_records")
}

// --- Fase 2: mensajeria WhatsApp --------------------------------------------

/// Numero de WhatsApp de un workspace. El token nunca se guarda en claro ni se
/// expone al cliente: se cifra con INTEGRATION_ENCRYPTION_KEY (ver lib/crypto).
/// `phoneNumberId` es unico global: es la llave con la que el webhook resuelve
/// a que workspace pertenece un evento entrante.
model WhatsAppChannel {
  id                   String                @id @default(cuid())
  workspaceId          String                @map("workspace_id")
  integrationId        String?               @map("integration_id")
  wabaId               String                @map("waba_id")
  phoneNumberId        String                @unique @map("phone_number_id")
  displayPhoneNumber   String                @map("display_phone_number")
  businessName         String?               @map("business_name")
  accessTokenEncrypted String?               @map("access_token_encrypted")
  tokenExpiresAt       DateTime?             @map("token_expires_at")
  status               WhatsAppChannelStatus @default(PENDING)
  qualityRating        String?               @map("quality_rating")
  messagingLimit       String?               @map("messaging_limit")
  webhookSubscribedAt  DateTime?             @map("webhook_subscribed_at")
  lastHealthCheckAt    DateTime?             @map("last_health_check_at")
  metadata             Json?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId, status])
  @@map("whatsapp_channels")
}

/// Hilo con un contacto en un canal. Estrategia de reapertura elegida: UNA
/// conversacion por (canal, contacto). Un mensaje entrante sobre una cerrada la
/// reabre en vez de crear otra, para no fragmentar el historial.
model Conversation {
  id                          String             @id @default(cuid())
  workspaceId                 String             @map("workspace_id")
  channelId                   String             @map("channel_id")
  contactId                   String             @map("contact_id")
  assignedUserId              String?            @map("assigned_user_id")
  mode                        ConversationMode   @default(WAITING)
  status                      ConversationStatus @default(OPEN)
  currentAgentId              String?            @map("current_agent_id")
  lastInboundAt               DateTime?          @map("last_inbound_at")
  lastOutboundAt              DateTime?          @map("last_outbound_at")
  lastMessageAt               DateTime           @default(now()) @map("last_message_at")
  customerServiceWindowEndsAt DateTime?          @map("customer_service_window_ends_at")
  unreadCount                 Int                @default(0) @map("unread_count")
  summary                     String?
  lockVersion                 Int                @default(0) @map("lock_version")
  closedAt                    DateTime?          @map("closed_at")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee   User?                    @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages   Message[]
  agentRuns  AgentRun[]
  agentState ConversationAgentState?

  @@unique([channelId, contactId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, assignedUserId])
  @@map("conversations")
}

model Message {
  id                String            @id @default(cuid())
  workspaceId       String            @map("workspace_id")
  conversationId    String            @map("conversation_id")
  externalMessageId String?           @unique @map("external_message_id")
  direction         MessageDirection
  senderType        MessageSenderType
  senderUserId      String?           @map("sender_user_id")
  agentRunId        String?           @map("agent_run_id")
  type              MessageType       @default(TEXT)
  text              String?
  payload           Json?
  status            MessageStatus     @default(QUEUED)
  errorCode         String?           @map("error_code")
  errorMessage      String?           @map("error_message")
  sentAt            DateTime?         @map("sent_at")
  deliveredAt       DateTime?         @map("delivered_at")
  readAt            DateTime?         @map("read_at")
  failedAt          DateTime?         @map("failed_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId, status])
  @@map("messages")
}

/// Evento crudo recibido de un proveedor. El webhook solo persiste y encola;
/// el procesamiento ocurre despues. `dedupeKey` da idempotencia: una reentrega
/// del mismo evento no produce un segundo mensaje.
model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String
  dedupeKey   String             @map("dedupe_key")
  externalId  String?            @map("external_id")
  payload     Json
  status      WebhookEventStatus @default(PENDING)
  attempts    Int                @default(0)
  error       String?
  processedAt DateTime?          @map("processed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([provider, dedupeKey])
  @@index([status, createdAt])
  @@map("webhook_events")
}

/// Patron outbox: toda accion externa se persiste antes de intentarse, para que
/// una llamada fallida no deje la base y el proveedor en estados distintos.
model OutboxEvent {
  id             String       @id @default(cuid())
  workspaceId    String?      @map("workspace_id")
  type           OutboxType
  payload        Json
  idempotencyKey String       @unique @map("idempotency_key")
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at")
  processedAt    DateTime?    @map("processed_at")
  error          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// --- Fase 3: cola durable, scheduler y motor de automatizaciones -------------

/// Trabajo de la cola durable.
///
/// Se implementa como tabla en vez de pgmq para que Prisma la tipe, las pruebas
/// la consulten y la pagina de Ops muestre profundidad y antiguedad por
/// workspace sin SQL crudo. El reclamo usa `FOR UPDATE SKIP LOCKED`, que da la
/// misma garantia de "un solo consumidor por trabajo".
model Job {
  id          String    @id @default(cuid())
  workspaceId String?   @map("workspace_id")
  type        JobType
  payload     Json
  status      JobStatus @default(PENDING)
  priority    Int       @default(100)
  runAt       DateTime  @default(now()) @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lastError   String?   @map("last_error")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")

  /// Idempotencia al encolar: dos disparos del mismo hecho no crean dos trabajos.
  dedupeKey   String?   @unique @map("dedupe_key")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt, priority])
  @@index([workspaceId, status])
  @@map("jobs")
}

/// Ejecucion de una regla sobre un hecho concreto.
///
/// El unique (ruleId, dedupeKey) es lo que garantiza "una ejecucion por evento":
/// aunque el trabajo se reintente, la regla no vuelve a actuar.
model AutomationExecution {
  id          String                    @id @default(cuid())
  workspaceId String                    @map("workspace_id")
  ruleId      String                    @map("rule_id")
  dedupeKey   String                    @map("dedupe_key")
  contactId   String?                   @map("contact_id")
  status      AutomationExecutionStatus @default(MATCHED)
  actionsRun  Int                       @default(0) @map("actions_run")
  result      Json?
  error       String?
  createdAt   DateTime                  @default(now()) @map("created_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, dedupeKey])
  @@index([workspaceId, createdAt])
  @@map("automation_executions")
}

// --- Fase 4: agentes IA ------------------------------------------------------

/// Agente de un workspace. La definicion es estable; lo que cambia son sus
/// versiones, para poder editar sin afectar lo que ya esta en produccion.
model AgentDefinition {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  key         AgentKind
  name        String
  purpose     String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  AgentVersion[]
  runs      AgentRun[]

  @@unique([workspaceId, key])
  @@map("agent_definitions")
}

/// Version de un agente: instrucciones, modelo, herramientas permitidas y
/// limites. Solo una puede estar PUBLISHED por agente; el resto queda como
/// historial o borrador. Publicar es una accion auditada, no un guardado.
model AgentVersion {
  id                String             @id @default(cuid())
  agentDefinitionId String             @map("agent_definition_id")
  version           Int
  instructions      String
  model             String
  /// temperature y demas opciones del proveedor.
  options           Json?
  /// Lista blanca de herramientas. Lo que no este aqui, el agente no puede usar.
  allowedTools      String[]           @default([]) @map("allowed_tools")
  maxSteps          Int                @default(6) @map("max_steps")
  /// Cuando debe escalar a un humano.
  escalationPolicy  Json?              @map("escalation_policy")
  status            AgentVersionStatus @default(DRAFT)
  createdById       String?            @map("created_by")
  publishedAt       DateTime?          @map("published_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  definition AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  runs       AgentRun[]

  @@unique([agentDefinitionId, version])
  @@index([agentDefinitionId, status])
  @@map("agent_versions")
}

/// Ejecucion de un agente. Guarda tokens, costo y latencia para poder medir el
/// gasto por workspace, que es la base del modelo comercial.
model AgentRun {
  id                String         @id @default(cuid())
  workspaceId       String         @map("workspace_id")
  conversationId    String?        @map("conversation_id")
  agentDefinitionId String         @map("agent_definition_id")
  agentVersionId    String         @map("agent_version_id")
  status            AgentRunStatus @default(RUNNING)
  trigger           String?
  inputSummary      String?        @map("input_summary")
  output            String?
  /// Cada tool call con sus argumentos y su resultado, para poder auditar que
  /// hizo el agente sin volver a llamarlo.
  toolCalls         Json?          @map("tool_calls")
  steps             Int            @default(0)
  inputTokens       Int            @default(0) @map("input_tokens")
  outputTokens      Int            @default(0) @map("output_tokens")
  costEstimate      Int            @default(0) @map("cost_estimate")
  latencyMs         Int            @default(0) @map("latency_ms")
  escalated         Boolean        @default(false)
  error             String?
  createdAt         DateTime       @default(now()) @map("created_at")

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  definition   AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  agentVersion AgentVersion    @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@map("agent_runs")
}

/// Estado del agente en una conversacion.
///
/// La base local es la fuente de verdad; `externalConversationId` es auxiliar y
/// puede perderse sin consecuencias. `lockedUntil` impide dos ejecuciones
/// simultaneas sobre la misma conversacion.
model ConversationAgentState {
  id                     String    @id @default(cuid())
  conversationId         String    @unique @map("conversation_id")
  currentAgentId         String?   @map("current_agent_id")
  externalConversationId String?   @map("external_conversation_id")
  state                  Json?
  summary                String?
  lastRunId              String?   @map("last_run_id")
  lockedUntil            DateTime? @map("locked_until")
  lockedBy               String?   @map("locked_by")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_agent_states")
}

